# =============================================================================
# mcp-deepseek-search — MCP server สำหรับค้นหาเว็บและอ่านหน้าเว็บผ่าน DeepSeek Search & Fetch API — ตัวอย่างไฟล์ .env
# เครื่องมือ: deepseek_search (ค้นหาเว็บ) และ deepseek_fetch (อ่านหน้าเว็บเป็น Markdown)
# -----------------------------------------------------------------------------
# ไฟล์นี้อธิบายการตั้งค่าทั้งหมดที่ปรับได้ โดยแบ่งเป็น 5 หมวดเช่นเดียวกับไฟล์ .env
# บรรทัดที่ไม่มี # นำหน้าคือค่าที่จำเป็นต้องกำหนดในไฟล์ .env
# บรรทัดที่มี # นำหน้าคือค่าเริ่มต้น หากไม่กำหนดในไฟล์ .env ระบบจะใช้ค่านี้
# เมื่อแก้ไขไฟล์ .env แล้ว ให้สั่ง docker compose up -d เพื่อสร้าง container ใหม่
# =============================================================================

# --- DeepSeek API ---
# API key (ค่าลับ) ขอได้ที่ https://platform.deepseek.com ต้องมียอดเงินในบัญชี (ไม่พอ = HTTP 402)
#   คิดเงินต่อครั้งที่สำเร็จ: Search และ Fetch ครั้งละ 0.00075 USD (ค้นแล้วไม่พบผลหรือดึงหน้าไม่สำเร็จไม่คิดเงิน)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# endpoint ของ DeepSeek API (เปลี่ยนเมื่อต้องเรียกผ่าน proxy ขององค์กร)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# เวลารอคำตอบสูงสุดของ Search และ Fetch (วินาที)
# SEARCH_TIMEOUT_SECONDS=30
# FETCH_TIMEOUT_SECONDS=60
# จำนวนครั้งที่ลองใหม่เมื่อได้ HTTP 408, 429, 5xx หรือเครือข่ายขัดข้อง
# RETRIES=2
# ราคาต่อครั้งที่สำเร็จ (USD) ใช้คำนวณค่าใช้จ่ายในข้อมูลการใช้งาน แก้เมื่อ DeepSeek เปลี่ยนราคา
# PRICE_PER_REQUEST_USD=0.00075

# --- เปิด/ปิดเครื่องมือ ---
# true = เอเจนต์เห็นและเรียกใช้ได้ · false = ไม่อยู่ในรายการเครื่องมือเลย (ไม่เสีย token ค่าคำอธิบาย และเรียกตรงไม่ได้)
# เปลี่ยนแล้วสั่ง docker compose up -d และรีสตาร์ต Hermes (หรือ /reload-mcp) เพราะ client อ่านรายการเครื่องมือตอนเชื่อมต่อ
# ค้นหาเว็บ ได้รายการผลลัพธ์พร้อมสรุป วันที่ ความน่าเชื่อถือ และคะแนนความเกี่ยวข้อง
ENABLE_DEEPSEEK_SEARCH=true
# อ่านเนื้อหาหน้าเว็บเป็น Markdown
ENABLE_DEEPSEEK_FETCH=true

# --- ผลลัพธ์ที่ส่งให้เอเจนต์ ---
# จำนวนผลค้นหาเมื่อเอเจนต์ไม่ได้ระบุ (1–50) ราคาเท่าเดิมไม่ว่าจะขอกี่รายการ แต่ยิ่งมากยิ่งใช้ token ของเอเจนต์
# DEFAULT_COUNT=10
# ความยาวสูงสุดของสรุปแต่ละรายการ (ตัวอักษร)
# SUMMARY_CHARS=800
# ความยาวสูงสุดของเนื้อหาแต่ละรายการเมื่อเอเจนต์ขอ with_content (ตัวอักษร)
# CONTENT_CHARS=3000
# ความยาวสูงสุดที่ deepseek_fetch ส่งกลับต่อครั้งเมื่อเอเจนต์ไม่ได้ระบุ หน้าที่ยาวกว่านี้อ่านต่อด้วย start
# FETCH_MAX_CHARS=20000
# IP address สำหรับให้ผลค้นหาเหมาะกับพื้นที่ เช่น IP ของเครือข่ายในประเทศไทย (เว้นว่าง = ไม่ระบุ)
# LOCALIZATION_IP=

# --- การทำงานร่วมกับเอเจนต์ ---
# หากกำหนด เอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง (ค่าลับ) ใช้กับ GET /usage ด้วย
#   หากเว้นว่างจะไม่ตรวจสอบ ⚠ เมื่อเปิดพอร์ตให้เครื่องอื่นเข้าถึง ทุกคนในเครือข่ายจะใช้ยอดเงิน DeepSeek ของคุณได้
# MCP_AUTH_TOKEN=
# บันทึกค่าใช้จ่ายและเวลาของการเรียก DeepSeek ทุกครั้ง (ไม่มีคำค้นหรือเนื้อหา) อ่านได้ที่ GET /usage
# USAGE_LOG=true
# USAGE_DIR=/app/usage

# --- docker compose ---
# docker network ที่ใช้ร่วมกับเอเจนต์ (ต้องสร้างก่อนด้วยคำสั่ง docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าถึงได้ · 127.0.0.1 = เข้าถึงได้เฉพาะเครื่องนี้
# PUBLISH_ADDR=0.0.0.0
# พอร์ตบนเครื่อง
# PUBLISH_PORT=8807
